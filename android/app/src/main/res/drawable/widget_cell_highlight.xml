<?xml version="1.0" encoding="utf-8"?>
<!-- Highlight applied to the cell of the next upcoming prayer, in the same
     light blue accent used for selected states elsewhere in the app
     (e.g. the selected Tasbeeh bead/mode). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#4D7DD3FC" />
    <stroke android:width="1dp" android:color="#AA7DD3FC" />
    <corners android:radius="12dp" />
</shape>
